{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShaniShvilin-Installer",
  "version": "1.0.0",
  "identifier": "co.abaye.shanishvilin.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "התקנת שני שבילין",
        "width": 980,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "© abaye. All rights reserved.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
