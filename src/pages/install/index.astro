---
import Base from "../../layouts/Base.astro";

const paths = [
  {
    id: "pc",
    href: "/install/pc",
    title: "תוכנת התקנה למחשב (Windows)",
    desc: "מורידים תוכנה קטנה, מחברים את המכשיר בכבל, והאשף עושה את השאר. הדרך היציבה ביותר במחשב Windows.",
  },
  {
    id: "web",
    href: "/install/web",
    title: "התקנה מהדפדפן",
    desc: "בלי להוריד כלום: מ-Chrome או מ-Edge במחשב (Windows, Mac, Linux או Chromebook), עם כבל USB.",
  },
  {
    id: "qr",
    href: "/install/qr",
    title: "סריקת QR במכשיר מאופס",
    desc: "למכשיר חדש או אחרי איפוס יצרן: מקישים 6 פעמים במסך הפתיחה וסורקים קוד. בלי מחשב ובלי כבל.",
  },
  {
    id: "no-computer",
    href: "#no-computer",
    title: "בלי מחשב, מתוך האפליקציה",
    desc: "באנדרואיד 11 ומעלה עם Wi-Fi: מתקינים את האפליקציה ישירות במכשיר, והיא מגדירה את עצמה בעזרת ניפוי באגים אלחוטי.",
  },
  {
    id: "car",
    href: "/car",
    title: "מולטימדיה לרכב",
    desc: "פותחים את העמוד ביחידה עצמה, מורידים ומתקינים, וממשיכים באשף \"בלי מחשב\".",
  },
  {
    id: "manual",
    href: "/install/manual",
    title: "התקנה ידנית בפקודות adb",
    desc: "למי שמכיר את adb: כל הפקודות, עם כפתורי העתקה.",
  },
];
---

<Base title="התקנה" description="בחירת דרך ההתקנה המתאימה לשני שבילין: מהמחשב, מהדפדפן, בסריקת QR או ישירות מהמכשיר.">
  <div class="page-head">
    <h1>התקנת שני שבילין</h1>
    <p class="lead">שתי שאלות קצרות, ונציע את הדרך המתאימה לכם.</p>
  </div>

  <form class="card chooser" id="chooser" onsubmit="return false">
    <fieldset>
      <legend>על איזה מכשיר מתקינים?</legend>
      <label><input type="radio" name="device" value="phone" /> טלפון או טאבלט</label>
      <label><input type="radio" name="device" value="car" /> מולטימדיה לרכב</label>
    </fieldset>
    <fieldset>
      <legend>יש לכם מחשב?</legend>
      <label><input type="radio" name="pc" value="windows" /> כן, Windows</label>
      <label><input type="radio" name="pc" value="other" /> כן, Mac, Linux או Chromebook</label>
      <label><input type="radio" name="pc" value="none" /> אין מחשב</label>
    </fieldset>
    <div id="recommendation" class="recommendation" aria-live="polite" hidden></div>
  </form>

  <div class="note before">
    <p>
      <strong>לפני כל התקנה:</strong> שני שבילין מוגדרת כמנהלת המכשיר, ולכן אנדרואיד דורש מכשיר <strong>בלי חשבונות</strong> (Google, היצרן,
      WhatsApp ודומיהם) ו<strong>בלי משתמשים נוספים</strong>. הדרך הפשוטה היא איפוס יצרן. אחרי ההתקנה אפשר להוסיף חשבונות מחדש.
    </p>
  </div>

  <h2 class="all-title">כל דרכי ההתקנה</h2>
  <div class="grid paths">
    {
      paths.map((p) => (
        <a class="card path" href={p.href} id={`path-${p.id}`}>
          <h3>{p.title}</h3>
          <p class="muted">{p.desc}</p>
        </a>
      ))
    }
  </div>

  <section class="card" id="no-computer">
    <h2>התקנה בלי מחשב (אנדרואיד 11 ומעלה)</h2>
    <p>מתאים לטלפון, לטאבלט וליחידות מולטימדיה עם אנדרואיד 11 ומעלה וחיבור Wi-Fi.</p>
    <ol class="steps">
      <li>מתחילים ממכשיר אחרי איפוס יצרן, או מסירים ממנו את כל החשבונות.</li>
      <li>בדפדפן של המכשיר נכנסים ל-<a href="/download">shanishvilin.abaye.co/download</a> ומורידים את הקובץ. אם הדפדפן שואל, מאשרים התקנה ממקור זה.</li>
      <li>פותחים את הקובץ שהורד ומתקינים.</li>
      <li>פותחים את שני שבילין. בשלב "הרשאת ניהול המכשיר" בוחרים <strong>"בלי מחשב"</strong>.</li>
      <li>מפעילים אפשרויות מפתחים: 7 הקשות על מספר הגרסה (או "מספר Build") בהגדרות.</li>
      <li>מפעילים "ניפוי באגים אלחוטי", לוחצים "התחלת צימוד", פותחים "צימוד מכשיר באמצעות קוד צימוד" ומקלידים את 6 הספרות בהתראה של שני שבילין.</li>
      <li>בסיום ניפוי הבאגים האלחוטי נכבה לבד. ממשיכים: בוחרים מסלול סינון, קובעים סיסמת הסרה ולוחצים "החל הגדרות".</li>
    </ol>
  </section>
</Base>

<script>
  const form = document.getElementById("chooser") as HTMLFormElement;
  const out = document.getElementById("recommendation") as HTMLElement;

  type Rec = { title: string; text: string; href: string; alt?: { text: string; href: string }[] };

  function recommend(device: string, pc: string): Rec | null {
    if (device === "car") {
      return {
        title: "מתקינים ישירות ביחידת הרכב",
        text: "ברוב יחידות המולטימדיה אין חיבור למחשב. פותחים בדפדפן של היחידה את shanishvilin.abaye.co/car.",
        href: "/car",
      };
    }
    if (!device || !pc) return null;
    if (pc === "windows") {
      return {
        title: "תוכנת ההתקנה למחשב",
        text: "הדרך המומלצת ב-Windows.",
        href: "/install/pc",
        alt: [{ text: "או מהדפדפן (Chrome / Edge)", href: "/install/web" }],
      };
    }
    if (pc === "other") {
      return { title: "התקנה מהדפדפן", text: "פותחים את העמוד ב-Chrome או ב-Edge במחשב ומחברים את המכשיר בכבל.", href: "/install/web" };
    }
    return {
      title: "בלי מחשב",
      text: "במכשיר חדש או מאופס: סריקת QR. באנדרואיד 11 ומעלה: גם התקנה מתוך האפליקציה.",
      href: "/install/qr",
      alt: [{ text: "התקנה מתוך האפליקציה (אנדרואיד 11 ומעלה)", href: "#no-computer" }],
    };
  }

  function update() {
    const data = new FormData(form);
    const rec = recommend(String(data.get("device") ?? ""), String(data.get("pc") ?? ""));
    if (!rec) {
      out.hidden = true;
      return;
    }
    out.hidden = false;
    out.replaceChildren();
    const h = document.createElement("strong");
    h.textContent = `ההמלצה שלנו: ${rec.title}`;
    const p = document.createElement("p");
    p.textContent = rec.text;
    const row = document.createElement("div");
    row.className = "btn-row";
    const a = document.createElement("a");
    a.className = "btn btn-primary";
    a.href = rec.href;
    a.textContent = "להמשך";
    row.append(a);
    for (const alt of rec.alt ?? []) {
      const b = document.createElement("a");
      b.className = "btn";
      b.href = alt.href;
      b.textContent = alt.text;
      row.append(b);
    }
    out.append(h, p, row);
  }

  form.addEventListener("change", update);
  // The phone question is irrelevant for car units.
  form.addEventListener("change", () => {
    const car = (form.elements.namedItem("device") as RadioNodeList).value === "car";
    form.querySelectorAll<HTMLFieldSetElement>("fieldset")[1].disabled = car;
  });
</script>

<style>
  .chooser {
    display: grid;
    gap: 16px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  fieldset[disabled] {
    opacity: 0.45;
  }
  legend {
    font-weight: 700;
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  fieldset label {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-strong);
    cursor: pointer;
  }
  fieldset label:has(input:checked) {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.18);
  }
  .recommendation {
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    background: rgba(0, 201, 167, 0.12);
    border: 1px solid rgba(0, 201, 167, 0.35);
  }
  .recommendation p {
    margin: 4px 0 12px;
  }
  .before {
    margin-top: 18px;
  }
  .all-title {
    margin-top: 40px;
  }
  .path {
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease;
  }
  .path:hover {
    transform: translateY(-2px);
  }
  .path h3 {
    margin-top: 0;
    color: var(--link);
  }
  #no-computer {
    margin-top: 32px;
    scroll-margin-top: 90px;
  }
</style>
